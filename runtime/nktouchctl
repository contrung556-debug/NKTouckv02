#!/var/jb/bin/sh
set -eu

BASE="/var/mobile/Library/NKTouch"
STATUS_FILE="$BASE/status.state"
LOG_FILE="$BASE/events.log"
HEARTBEAT_FILE="$BASE/heartbeat"
NATIVE="/var/jb/usr/libexec/nktouch/nktouch-native"
RUNNER="/var/jb/usr/bin/nktouch-run"
LUA_BIN="/var/jb/usr/libexec/nktouch/lua"
PY="/var/jb/usr/bin/python3"
HELPER="/var/jb/usr/share/nktouch/nktouchctl.py"

mkdir -p "$BASE"

now() {
  /var/jb/usr/bin/date +%s 2>/dev/null || date +%s
}

sanitize() {
  printf '%s' "$*" | tr '\r\n|' '   '
}

write_status() {
  style="$1"
  percent="$2"
  shift 2
  msg="$(sanitize "$*")"
  case "$percent" in
    ''|*[!0-9]*) percent=0 ;;
  esac
  [ "$percent" -lt 0 ] 2>/dev/null && percent=0 || true
  [ "$percent" -gt 100 ] 2>/dev/null && percent=100 || true
  tmp="$STATUS_FILE.tmp.$$"
  printf '%s|%s|%s|%s\n' "$style" "$percent" "$msg" "$(now)" > "$tmp"
  mv -f "$tmp" "$STATUS_FILE"
  chmod 666 "$STATUS_FILE" 2>/dev/null || true
}

append_log() {
  mkdir -p "$BASE"
  printf '%s %s\n' "$(now)" "$(sanitize "$*")" >> "$LOG_FILE"
  chmod 666 "$LOG_FILE" 2>/dev/null || true
  size=$(wc -c < "$LOG_FILE" 2>/dev/null || echo 0)
  if [ "$size" -gt 524288 ] 2>/dev/null; then
    tail -n 500 "$LOG_FILE" > "$LOG_FILE.tmp" && mv -f "$LOG_FILE.tmp" "$LOG_FILE"
  fi
}

need_python() {
  if [ ! -x "$PY" ]; then
    echo "NKTouch: native backend bị thiếu và máy cũng không có Python fallback." >&2
    exit 3
  fi
  if [ ! -f "$HELPER" ]; then
    echo "NKTouch: thiếu helper fallback $HELPER" >&2
    exit 4
  fi
}

run_native_first() {
  subcmd="$1"
  shift || true
  if [ -x "$NATIVE" ]; then
    exec "$NATIVE" "$subcmd" "$@"
  fi

  # Emergency compatibility path for an incomplete/old upgrade only.
  need_python
  exec "$PY" "$HELPER" "$subcmd" "$@"
}

cmd="${1:-help}"
shift || true

case "$cmd" in
  status)
    pct="${1:-0}"; shift || true
    write_status normal "$pct" "$*"
    ;;
  success)
    write_status success 100 "$*"
    ;;
  warning|warn)
    write_status warning 0 "$*"
    ;;
  error|fail)
    write_status error 0 "$*"
    ;;
  hide)
    write_status hide 0 ""
    ;;
  heartbeat)
    printf '%s\n' "$(now)" > "$HEARTBEAT_FILE"
    chmod 666 "$HEARTBEAT_FILE" 2>/dev/null || true
    ;;
  log)
    append_log "$*"
    ;;
  state)
    if [ -f "$STATUS_FILE" ]; then cat "$STATUS_FILE"; else echo "hide|0||0"; fi
    ;;
  logs)
    tail -n "${1:-50}" "$LOG_FILE" 2>/dev/null || true
    ;;
  backend)
    if [ -x "$NATIVE" ]; then
      printf 'native %s\n' "$($NATIVE version 2>/dev/null || echo unknown)"
    elif [ -x "$PY" ] && [ -f "$HELPER" ]; then
      echo "python-fallback"
    else
      echo "unavailable"
      exit 4
    fi
    ;;
  lua-version)
    if [ ! -x "$LUA_BIN" ]; then
      echo "NKTouch: Lua runtime chưa được cài ở $LUA_BIN" >&2
      exit 4
    fi
    exec "$LUA_BIN" -v
    ;;
  run)
    if [ ! -x "$RUNNER" ]; then
      echo "NKTouch: Lua runner chưa được cài ở $RUNNER" >&2
      exit 4
    fi
    exec "$RUNNER" "$@"
    ;;
  ping)
    if [ -x "$NATIVE" ]; then
      exec "$NATIVE" ping
    fi
    need_python
    exec "$PY" "$HELPER" screen
    ;;
  tap|hold|swipe|openapp|stop|screen|foreground)
    run_native_first "$cmd" "$@"
    ;;
  record)
    run_native_first record "$@"
    ;;
  native)
    if [ ! -x "$NATIVE" ]; then
      echo "NKTouch: native backend chưa được cài ở $NATIVE" >&2
      exit 4
    fi
    exec "$NATIVE" "$@"
    ;;
  help|-h|--help)
    cat <<'HELP'
NKTouch v0.4 native + standalone Lua

Lua runtime (AutoTouch/Python NOT required):
  nktouchctl run <script.lua> [args...]
  nktouchctl lua-version
  nktouch-run <script.lua> [args...]

Status:
  nktouchctl status <0-100> <message>
  nktouchctl success <message>
  nktouchctl warning <message>
  nktouchctl error <message>
  nktouchctl hide
  nktouchctl heartbeat
  nktouchctl log <message>
  nktouchctl state
  nktouchctl logs [lines]

Native automation (Python 3 NOT required):
  nktouchctl tap <x> <y>
  nktouchctl hold <x> <y> <ms>
  nktouchctl swipe <x1> <y1> <x2> <y2> <ms>
  nktouchctl openapp <bundle-id>
  nktouchctl record start|stop
  nktouchctl stop
  nktouchctl screen
  nktouchctl foreground
  nktouchctl ping
  nktouchctl backend

Debug/native passthrough:
  nktouchctl native <native-command> [...]
HELP
    ;;
  *)
    echo "NKTouch: unknown command '$cmd'" >&2
    echo "Run: nktouchctl help" >&2
    exit 2
    ;;
esac
