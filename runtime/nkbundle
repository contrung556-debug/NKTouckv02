#!/var/jb/bin/sh
set -u

VERSION="0.7.3"
ROOT="/var/mobile/Library/NKTouch"
SCRIPTS="$ROOT/scripts"
ASSETS="$ROOT/assets"
BUNDLES="$ROOT/bundles"
TMP="$ROOT/tmp"
LUA="/var/jb/usr/libexec/nktouch/lua54"
LUAC="/var/jb/usr/libexec/nktouch/luac54"
PACKER="/var/jb/usr/share/nktouch/nkbundle.lua"

need_runtime() {
  [ -x "$LUA" ] || { echo "NKTouch Bundle: missing Lua runtime" >&2; exit 4; }
  [ -x "$LUAC" ] || { echo "NKTouch Bundle: missing Lua compiler" >&2; exit 4; }
  [ -f "$PACKER" ] || { echo "NKTouch Bundle: missing bundle library" >&2; exit 4; }
}

mkdir_state() {
  mkdir -p "$SCRIPTS" "$ASSETS" "$BUNDLES" "$TMP" 2>/dev/null || {
    echo "NKTouch Bundle: cannot create state directories" >&2
    exit 4
  }
}

safe_name() {
  n="$1"
  [ -n "$n" ] || return 1
  [ "${#n}" -le 80 ] || return 1
  case "$n" in .*|*..*|*/*|*[!A-Za-z0-9._-]*) return 1 ;; esac
  case "$n" in [A-Za-z0-9]*) return 0 ;; *) return 1 ;; esac
}

safe_asset() {
  n="$1"
  [ -n "$n" ] || return 1
  [ "${#n}" -le 120 ] || return 1
  case "$n" in .*|*..*|*/*|*[!A-Za-z0-9._-]*) return 1 ;; esac
  case "$n" in [A-Za-z0-9]*) return 0 ;; *) return 1 ;; esac
}

script_path() {
  n="$1"
  safe_name "$n" || return 1
  case "$n" in *.lua) printf '%s/%s\n' "$SCRIPTS" "$n" ;; *) printf '%s/%s.lua\n' "$SCRIPTS" "$n" ;; esac
}

base_name() {
  n="$1"
  n="${n%.lua}"
  safe_name "$n" || return 1
  printf '%s\n' "$n"
}

cmd="${1:-help}"
[ "$#" -gt 0 ] && shift || true

case "$cmd" in
  version)
    echo "$VERSION"
    ;;
  doctor)
    mkdir_state
    need_runtime
    probe="$TMP/nkbundle-probe-$$"
    mkdir -p "$probe/assets" || exit 4
    printf '%s\n' 'local nk=require("nktouch")' 'print("bundle-probe")' > "$probe/script.lua"
    "$LUAC" -p "$probe/script.lua" || { rm -rf "$probe"; echo "bundle_syntax=failed"; exit 7; }
    "$LUA" "$PACKER" pack probe "$probe/script.lua" "$probe/probe.nktask" >/dev/null || { rm -rf "$probe"; echo "bundle_pack=failed"; exit 7; }
    "$LUA" "$PACKER" inspect "$probe/probe.nktask" >/dev/null || { rm -rf "$probe"; echo "bundle_inspect=failed"; exit 7; }
    mkdir -p "$probe/out/assets"
    "$LUA" "$PACKER" extract "$probe/probe.nktask" "$probe/out" >/dev/null || { rm -rf "$probe"; echo "bundle_extract=failed"; exit 7; }
    cmp "$probe/script.lua" "$probe/out/script.lua" >/dev/null 2>&1 || { rm -rf "$probe"; echo "bundle_roundtrip=failed"; exit 7; }
    rm -rf "$probe"
    echo "bundle=$VERSION"
    echo "format=NKTASK1"
    echo "bundles=$BUNDLES"
    echo "assets=$ASSETS"
    echo "max_bundle_mib=32"
    echo "result=PASS"
    ;;
  asset)
    sub="${1:-help}"
    [ "$#" -gt 0 ] && shift || true
    case "$sub" in
      add)
        [ "$#" -ge 2 ] && [ "$#" -le 3 ] || { echo "usage: nktouchctl bundle asset add <script> <file> [asset-name]" >&2; exit 2; }
        mkdir_state
        name="$(base_name "$1")" || { echo "NKTouch Bundle: invalid script name" >&2; exit 2; }
        src="$2"
        [ -f "$src" ] && [ -r "$src" ] || { echo "NKTouch Bundle: asset source not readable: $src" >&2; exit 5; }
        if [ "$#" -eq 3 ]; then asset="$3"; else asset="${src##*/}"; fi
        safe_asset "$asset" || { echo "NKTouch Bundle: invalid asset name" >&2; exit 2; }
        dir="$ASSETS/$name"
        mkdir -p "$dir" || exit 4
        dst="$dir/$asset"
        [ ! -e "$dst" ] || { echo "NKTouch Bundle: asset already exists: $asset" >&2; exit 3; }
        cat "$src" > "$dst" || { rm -f "$dst"; exit 5; }
        chmod 644 "$dst" 2>/dev/null || true
        echo "asset=$dst"
        ;;
      list)
        [ "$#" -eq 1 ] || { echo "usage: nktouchctl bundle asset list <script>" >&2; exit 2; }
        mkdir_state
        name="$(base_name "$1")" || { echo "NKTouch Bundle: invalid script name" >&2; exit 2; }
        dir="$ASSETS/$name"
        [ -d "$dir" ] || exit 0
        for f in "$dir"/*; do [ -f "$f" ] || continue; basename "$f"; done
        ;;
      remove|rm)
        [ "$#" -eq 2 ] || { echo "usage: nktouchctl bundle asset remove <script> <asset-name>" >&2; exit 2; }
        name="$(base_name "$1")" || { echo "NKTouch Bundle: invalid script name" >&2; exit 2; }
        asset="$2"; safe_asset "$asset" || { echo "NKTouch Bundle: invalid asset name" >&2; exit 2; }
        file="$ASSETS/$name/$asset"
        [ -f "$file" ] || { echo "NKTouch Bundle: asset not found: $asset" >&2; exit 5; }
        rm -f "$file"
        echo "removed=$asset"
        ;;
      *) echo "usage: nktouchctl bundle asset add|list|remove ..." >&2; exit 2 ;;
    esac
    ;;
  export)
    [ "$#" -ge 1 ] && [ "$#" -le 2 ] || { echo "usage: nktouchctl bundle export <script> [output.nktask]" >&2; exit 2; }
    mkdir_state
    need_runtime
    name="$(base_name "$1")" || { echo "NKTouch Bundle: invalid script name" >&2; exit 2; }
    script="$(script_path "$name")" || exit 2
    [ -f "$script" ] && [ -r "$script" ] || { echo "NKTouch Bundle: script not found: $script" >&2; exit 5; }
    "$LUAC" -p "$script" || { echo "NKTouch Bundle: refusing to export script with syntax errors" >&2; exit 7; }
    if [ "$#" -eq 2 ]; then out="$2"; else out="$BUNDLES/$name.nktask"; fi
    case "$out" in *.nktask) ;; *) out="$out.nktask" ;; esac
    [ ! -e "$out" ] || { echo "NKTouch Bundle: output already exists: $out" >&2; exit 3; }
    adir="$ASSETS/$name"
    set -- "$name" "$script" "$out"
    if [ -d "$adir" ]; then
      for f in "$adir"/*; do
        [ -f "$f" ] || continue
        set -- "$@" "$f"
      done
    fi
    "$LUA" "$PACKER" pack "$@" || { rm -f "$out"; exit 7; }
    ;;
  inspect)
    [ "$#" -eq 1 ] || { echo "usage: nktouchctl bundle inspect <file.nktask>" >&2; exit 2; }
    need_runtime
    "$LUA" "$PACKER" inspect "$1"
    ;;
  import|install)
    [ "$#" -ge 1 ] && [ "$#" -le 2 ] || { echo "usage: nktouchctl bundle import <file.nktask> [name]" >&2; exit 2; }
    mkdir_state
    need_runtime
    bundle="$1"
    [ -f "$bundle" ] && [ -r "$bundle" ] || { echo "NKTouch Bundle: bundle not readable: $bundle" >&2; exit 5; }
    embedded="$($LUA "$PACKER" name "$bundle")" || exit $?
    if [ "$#" -eq 2 ]; then name="$(base_name "$2")" || { echo "NKTouch Bundle: invalid destination name" >&2; exit 2; }; else name="$(base_name "$embedded")" || exit 2; fi
    dst_script="$SCRIPTS/$name.lua"
    dst_assets="$ASSETS/$name"
    [ ! -e "$dst_script" ] || { echo "NKTouch Bundle: script already exists: $dst_script" >&2; exit 3; }
    [ ! -e "$dst_assets" ] || { echo "NKTouch Bundle: asset directory already exists: $dst_assets" >&2; exit 3; }
    stage="$TMP/nkbundle-import-$$"
    rm -rf "$stage"
    mkdir -p "$stage/assets" || exit 4
    "$LUA" "$PACKER" extract "$bundle" "$stage" || { rc=$?; rm -rf "$stage"; exit "$rc"; }
    "$LUAC" -p "$stage/script.lua" || { rm -rf "$stage"; echo "NKTouch Bundle: imported script failed syntax check" >&2; exit 7; }
    mv "$stage/script.lua" "$dst_script" || { rm -rf "$stage"; exit 5; }
    if [ -n "$(find "$stage/assets" -type f -maxdepth 1 2>/dev/null | head -1)" ]; then
      mv "$stage/assets" "$dst_assets" || { rm -f "$dst_script"; rm -rf "$stage"; exit 5; }
    fi
    rm -rf "$stage"
    chmod 644 "$dst_script" 2>/dev/null || true
    [ ! -d "$dst_assets" ] || chmod 755 "$dst_assets" 2>/dev/null || true
    echo "imported=$dst_script"
    [ ! -d "$dst_assets" ] || echo "assets=$dst_assets"
    echo "bundle_name=$embedded"
    echo "installed_name=$name"
    ;;
  list)
    mkdir_state
    for f in "$BUNDLES"/*.nktask; do [ -f "$f" ] || continue; basename "$f"; done
    ;;
  help|-h|--help)
    cat <<'HELP'
NKTouch v0.7.3 Task Bundle

  nktouchctl bundle asset add <script> <file> [asset-name]
  nktouchctl bundle asset list <script>
  nktouchctl bundle asset remove <script> <asset-name>
  nktouchctl bundle export <script> [output.nktask]
  nktouchctl bundle inspect <file.nktask>
  nktouchctl bundle import <file.nktask> [name]
  nktouchctl bundle list
  nktouchctl bundle doctor

.nktask is a single dependency-free NKTouch container containing one Lua script
plus optional flat assets. Import validates magic, size limits, entry names,
checksums and Lua syntax before installing anything. Existing scripts/assets are
never overwritten automatically.
HELP
    ;;
  *)
    echo "NKTouch Bundle: unknown command: $cmd" >&2
    exit 2
    ;;
esac
