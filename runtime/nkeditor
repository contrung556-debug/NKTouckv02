#!/var/jb/bin/sh
set -u

VERSION="0.7.2"
PATH="/var/jb/usr/bin:/var/jb/bin:/usr/bin:/bin"
SCRIPTS="/var/mobile/Library/NKTouch/scripts"
LUAC="/var/jb/usr/libexec/nktouch/luac54"
TASK="/var/jb/usr/bin/nktask"
API="/var/jb/usr/share/nktouch/nktouch-api.tsv"

mkdir_state() {
  mkdir -p "$SCRIPTS" 2>/dev/null || {
    echo "NKTouch Editor: cannot create $SCRIPTS" >&2
    exit 4
  }
}

need_runtime() {
  [ -x "$LUAC" ] || { echo "NKTouch Editor: missing Lua compiler: $LUAC" >&2; exit 4; }
  [ -x "$TASK" ] || { echo "NKTouch Editor: missing task engine: $TASK" >&2; exit 4; }
  [ -r "$API" ] || { echo "NKTouch Editor: missing API catalog: $API" >&2; exit 4; }
}

safe_name() {
  n="${1:-}"
  [ -n "$n" ] || return 1
  case "$n" in */*|.*|*..*) return 1 ;; esac
  clean="$(printf '%s' "$n" | tr -cd 'A-Za-z0-9._-')"
  [ "$clean" = "$n" ] || return 1
  case "$clean" in *.lua) ;; *) clean="$clean.lua" ;; esac
  printf '%s\n' "$clean"
}

script_path() {
  n="$(safe_name "${1:-}")" || return 1
  printf '%s/%s\n' "$SCRIPTS" "$n"
}

need_script() {
  p="$(script_path "${1:-}")" || { echo "NKTouch Editor: invalid script name" >&2; return 2; }
  [ -f "$p" ] || { echo "NKTouch Editor: script not found: $p" >&2; return 5; }
  printf '%s\n' "$p"
}

check_file() {
  file="$1"
  if "$LUAC" -p "$file"; then
    echo "syntax=ok"
    echo "script=$file"
    return 0
  fi
  echo "syntax=error" >&2
  echo "script=$file" >&2
  return 7
}

emit_template() {
  template="${1:-blank}"
  case "$template" in
    blank)
      cat <<'LUA'
-- NKTouch V7.2 script
local nk = require("nktouch")

local function must(value, err)
  if value == nil or value == false then error(err or "NKTouch action failed", 2) end
  return value
end

-- Add actions below.
LUA
      ;;
    tap)
      cat <<'LUA'
-- NKTouch V7.2 tap starter
local nk = require("nktouch")
local function must(value, err)
  if value == nil or value == false then error(err or "NKTouch action failed", 2) end
  return value
end

must(nk.tap(120, 450))
must(nk.sleep(500))
LUA
      ;;
    image)
      cat <<'LUA'
-- NKTouch V7.2 image starter
local nk = require("nktouch")
local function must(value, err)
  if value == nil or value == false then error(err or "NKTouch action failed", 2) end
  return value
end

local image = "/var/mobile/button.png"
local hit = must(nk.waitImage(image, 5000, 250, 0.80))
print("found image at", hit.x, hit.y, hit.width, hit.height)
must(nk.tapImage(image, 5000, 250, 0.80))
LUA
      ;;
    color)
      cat <<'LUA'
-- NKTouch V7.2 color starter
local nk = require("nktouch")
local function must(value, err)
  if value == nil or value == false then error(err or "NKTouch action failed", 2) end
  return value
end

local hit = must(nk.waitColor(0, 0, 750, 1334, 200, 255, 0, 80, 0, 80, 5000, 200, 0))
print("found color at", hit.x, hit.y)
must(nk.tap(hit.x, hit.y))
LUA
      ;;
    ocr)
      cat <<'LUA'
-- NKTouch V7.2 explicit OCR starter
-- OCR runs only because this script explicitly calls nk.ocr.
local nk = require("nktouch")
local function must(value, err)
  if value == nil or value == false then error(err or "NKTouch action failed", 2) end
  return value
end

local text = must(nk.ocr(0, 0, 750, 300, "en-US"))
print(text)
LUA
      ;;
    *)
      echo "NKTouch Editor: unknown template '$template' (blank|tap|image|color|ocr)" >&2
      return 2
      ;;
  esac
}

show_file() {
  awk '{ printf "%4d  %s\n", NR, $0 }' "$1"
}

api_query() {
  q="${1:-}"
  if [ -z "$q" ]; then
    awk -F'|' 'BEGIN{printf "%-24s %-12s %s\n","API","CATEGORY","SIGNATURE"} !/^#/ {printf "%-24s %-12s %s\n",$1,$3,$2}' "$API"
    return
  fi
  awk -F'|' -v q="$q" '
    BEGIN{lq=tolower(q); found=0}
    !/^#/ {
      if ($1==q || index(tolower($1),lq) || index(tolower($2),lq) || index(tolower($3),lq) || index(tolower($4),lq)) {
        printf "%s\n  signature: %s\n  category:  %s\n  help:      %s\n  example:   %s\n\n",$1,$2,$3,$4,$5
        found=1
      }
    }
    END{if(!found) exit 1}
  ' "$API" || { echo "NKTouch Editor: no API match for '$q'" >&2; return 6; }
}

complete_api() {
  prefix="${1:-nk.}"
  awk -F'|' -v p="$prefix" '!/^#/ && index($1,p)==1 {printf "%-24s %s\n",$1,$2}' "$API"
}

snippet_line() {
  q="${1:-}"
  [ -n "$q" ] || return 2
  case "$q" in nk.*) ;; *) q="nk.$q" ;; esac
  awk -F'|' -v q="$q" '!/^#/ && $1==q {print $5; found=1} END{if(!found) exit 1}' "$API"
}

find_editor() {
  for candidate in nano micro vim vi; do
    p="$(command -v "$candidate" 2>/dev/null || true)"
    [ -n "$p" ] && [ -x "$p" ] && { printf '%s\n' "$p"; return 0; }
  done
  return 1
}

append_checked() {
  file="$1"
  line="$2"
  backup="$file.bak.$$"
  cp "$file" "$backup" || return 4
  printf '%s\n' "$line" >> "$file" || { mv "$backup" "$file"; return 4; }
  if check_file "$file"; then
    rm -f "$backup"
    return 0
  fi
  mv "$backup" "$file"
  return 7
}

cmd="${1:-help}"
[ "$#" -gt 0 ] && shift || true

case "$cmd" in
  version)
    echo "$VERSION"
    ;;
  doctor)
    mkdir_state
    need_runtime
    probe="$SCRIPTS/.nktouch-editor-probe-$$.lua"
    printf '%s\n' 'local nk=require("nktouch")' 'assert(type(nk)=="table")' > "$probe" || exit 4
    "$LUAC" -p "$probe" || { rm -f "$probe"; echo "editor_syntax=failed"; exit 7; }
    rm -f "$probe"
    api_count="$(awk -F'|' '!/^#/ {n++} END{print n+0}' "$API")"
    echo "editor=$VERSION"
    echo "scripts=$SCRIPTS"
    echo "luac=ok"
    echo "task_engine=ok"
    echo "api_catalog=ok:$api_count"
    editor="$(find_editor 2>/dev/null || true)"
    if [ -n "$editor" ]; then echo "interactive_editor=$editor"; else echo "interactive_editor=optional:not-installed"; fi
    echo "result=PASS"
    ;;
  new)
    [ "$#" -ge 1 ] && [ "$#" -le 2 ] || { echo "usage: nktouchctl editor new <name> [blank|tap|image|color|ocr]" >&2; exit 2; }
    mkdir_state
    need_runtime
    file="$(script_path "$1")" || { echo "NKTouch Editor: invalid script name" >&2; exit 2; }
    [ ! -e "$file" ] || { echo "NKTouch Editor: script already exists: $file" >&2; exit 3; }
    template="${2:-blank}"
    tmp="$file.tmp.$$"
    rc=0
    emit_template "$template" > "$tmp" || rc=$?
    if [ "$rc" -ne 0 ]; then rm -f "$tmp"; exit "$rc"; fi
    "$LUAC" -p "$tmp" || { rm -f "$tmp"; echo "NKTouch Editor: generated template failed syntax check" >&2; exit 7; }
    mv "$tmp" "$file" || { rm -f "$tmp"; exit 4; }
    chmod 644 "$file" 2>/dev/null || true
    echo "created=$file"
    echo "template=$template"
    ;;
  import)
    [ "$#" -ge 1 ] && [ "$#" -le 2 ] || { echo "usage: nktouchctl editor import <source.lua> [name]" >&2; exit 2; }
    mkdir_state
    need_runtime
    source="$1"
    [ -f "$source" ] && [ -r "$source" ] || { echo "NKTouch Editor: source not readable: $source" >&2; exit 5; }
    if [ "$#" -eq 2 ]; then name="$2"; else name="$(basename "$source")"; fi
    file="$(script_path "$name")" || { echo "NKTouch Editor: invalid destination name" >&2; exit 2; }
    [ ! -e "$file" ] || { echo "NKTouch Editor: destination exists: $file" >&2; exit 3; }
    "$LUAC" -p "$source" || { echo "NKTouch Editor: source has Lua syntax errors" >&2; exit 7; }
    tmp="$file.tmp.$$"
    cp "$source" "$tmp" || exit 4
    mv "$tmp" "$file" || { rm -f "$tmp"; exit 4; }
    chmod 644 "$file" 2>/dev/null || true
    echo "imported=$file"
    ;;
  clone)
    [ "$#" -eq 2 ] || { echo "usage: nktouchctl editor clone <source-name> <new-name>" >&2; exit 2; }
    mkdir_state
    source="$(need_script "$1")" || exit $?
    dest="$(script_path "$2")" || { echo "NKTouch Editor: invalid destination name" >&2; exit 2; }
    [ ! -e "$dest" ] || { echo "NKTouch Editor: destination exists: $dest" >&2; exit 3; }
    cp "$source" "$dest" || exit 4
    chmod 644 "$dest" 2>/dev/null || true
    echo "cloned=$dest"
    ;;
  list)
    mkdir_state
    set -- "$SCRIPTS"/*.lua
    if [ ! -f "$1" ]; then echo "(no scripts)"; exit 0; fi
    ls -1t "$SCRIPTS"/*.lua
    ;;
  path)
    [ "$#" -eq 1 ] || { echo "usage: nktouchctl editor path <name>" >&2; exit 2; }
    mkdir_state
    script_path "$1" || { echo "NKTouch Editor: invalid script name" >&2; exit 2; }
    ;;
  show)
    [ "$#" -eq 1 ] || { echo "usage: nktouchctl editor show <name>" >&2; exit 2; }
    mkdir_state
    file="$(need_script "$1")" || exit $?
    show_file "$file"
    ;;
  check)
    [ "$#" -eq 1 ] || { echo "usage: nktouchctl editor check <name>" >&2; exit 2; }
    mkdir_state
    need_runtime
    file="$(need_script "$1")" || exit $?
    check_file "$file"
    ;;
  edit)
    [ "$#" -eq 1 ] || { echo "usage: nktouchctl editor edit <name>" >&2; exit 2; }
    mkdir_state
    need_runtime
    file="$(need_script "$1")" || exit $?
    editor="$(find_editor 2>/dev/null || true)"
    if [ -z "$editor" ]; then
      echo "NKTouch Editor: no nano/micro/vim/vi installed" >&2
      echo "script=$file"
      exit 6
    fi
    "$editor" "$file"
    rc=$?
    [ "$rc" -eq 0 ] || exit "$rc"
    check_file "$file"
    ;;
  append)
    [ "$#" -ge 2 ] || { echo "usage: nktouchctl editor append <name> <lua-code...>" >&2; exit 2; }
    mkdir_state
    need_runtime
    file="$(need_script "$1")" || exit $?
    shift
    if append_checked "$file" "$*"; then exit 0; fi
    rc=$?
    echo "NKTouch Editor: append reverted because syntax check failed" >&2
    exit "$rc"
    ;;
  delete)
    [ "$#" -eq 2 ] && [ "$2" = "--yes" ] || { echo "usage: nktouchctl editor delete <name> --yes" >&2; exit 2; }
    mkdir_state
    file="$(need_script "$1")" || exit $?
    rm -f "$file" || exit 4
    echo "deleted=$file"
    ;;
  api)
    need_runtime
    [ "$#" -le 1 ] || { echo "usage: nktouchctl editor api [query]" >&2; exit 2; }
    api_query "${1:-}"
    ;;
  complete)
    need_runtime
    [ "$#" -le 1 ] || { echo "usage: nktouchctl editor complete [prefix]" >&2; exit 2; }
    complete_api "${1:-nk.}"
    ;;
  snippet)
    [ "$#" -ge 1 ] && [ "$#" -le 2 ] || { echo "usage: nktouchctl editor snippet <api> [script-name]" >&2; exit 2; }
    need_runtime
    line="$(snippet_line "$1" 2>/dev/null || true)"
    [ -n "$line" ] || { echo "NKTouch Editor: no snippet for '$1'" >&2; exit 6; }
    if [ "$#" -eq 1 ]; then
      echo "$line"
    else
      mkdir_state
      file="$(need_script "$2")" || exit $?
      if append_checked "$file" "$line"; then echo "snippet=$line"; exit 0; fi
      rc=$?
      echo "NKTouch Editor: snippet reverted because syntax check failed" >&2
      exit "$rc"
    fi
    ;;
  run)
    [ "$#" -ge 1 ] || { echo "usage: nktouchctl editor run <name> [--timeout SEC] [-- args...]" >&2; exit 2; }
    mkdir_state
    need_runtime
    file="$(need_script "$1")" || exit $?
    shift
    "$LUAC" -p "$file" || { echo "NKTouch Editor: refusing to run script with syntax errors" >&2; exit 7; }
    exec "$TASK" start "$file" "$@"
    ;;
  status)
    need_runtime
    exec "$TASK" status "$@"
    ;;
  pause)
    need_runtime
    exec "$TASK" pause "$@"
    ;;
  resume)
    need_runtime
    exec "$TASK" resume "$@"
    ;;
  stop)
    need_runtime
    exec "$TASK" stop "$@"
    ;;
  logs)
    need_runtime
    exec "$TASK" logs "$@"
    ;;
  help|-h|--help)
    cat <<'HELP'
NKTouch V7.2 Script Editor

Workspace:
  nktouchctl editor new <name> [blank|tap|image|color|ocr]
  nktouchctl editor import <source.lua> [name]
  nktouchctl editor clone <source-name> <new-name>
  nktouchctl editor list
  nktouchctl editor path <name>
  nktouchctl editor show <name>
  nktouchctl editor edit <name>
  nktouchctl editor append <name> <lua-code...>
  nktouchctl editor check <name>
  nktouchctl editor delete <name> --yes

API help / completion:
  nktouchctl editor api [query]
  nktouchctl editor complete [prefix]
  nktouchctl editor snippet <api> [script-name]

Run controls:
  nktouchctl editor run <name> [--timeout SEC] [-- args...]
  nktouchctl editor status [TASK_ID]
  nktouchctl editor pause [TASK_ID]
  nktouchctl editor resume [TASK_ID]
  nktouchctl editor stop [TASK_ID]
  nktouchctl editor logs [TASK_ID] [LINES]

Managed scripts live under /var/mobile/Library/NKTouch/scripts.
The editor syntax-checks generated/imported scripts and always checks again before run.
Interactive editing uses nano, micro, vim, or vi when one is already installed.
OCR is never automatic; the OCR template only runs OCR when that script is executed.
HELP
    ;;
  *)
    echo "NKTouch Editor: unknown command: $cmd" >&2
    exit 2
    ;;
esac
